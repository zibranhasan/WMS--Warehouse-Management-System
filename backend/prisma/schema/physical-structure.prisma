// =============================================================================
// Warehouse Physical Structure Models
// Zone -> Aisle -> Shelf -> Bin
// =============================================================================

model Zone {
  id          String         @id @default(cuid())
  warehouseId String
  code        String
  name        String
  description String?
  capacity    Int            @default(0)
  status      LocationStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  aisles    Aisle[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model Aisle {
  id          String         @id @default(cuid())
  zoneId      String
  code        String
  name        String
  description String?
  capacity    Int            @default(0)
  status      LocationStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  shelves Shelf[]

  @@unique([zoneId, code])
  @@map("aisles")
}

model Shelf {
  id          String         @id @default(cuid())
  aisleId     String
  code        String
  name        String
  description String?
  capacity    Int            @default(0)
  status      LocationStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aisle Aisle @relation(fields: [aisleId], references: [id], onDelete: Restrict)
  bins  Bin[]

  @@unique([aisleId, code])
  @@map("shelves")
}

model Bin {
  id          String         @id @default(cuid())
  shelfId     String
  code        String
  name        String
  description String?
  capacity    Int            @default(0)
  status      LocationStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Restrict)

  inventoryLocationStocks InventoryLocationStock[]
  fromLocationMovements   InventoryLocationMovement[] @relation("FromBinLocationMovements")
  toLocationMovements     InventoryLocationMovement[] @relation("ToBinLocationMovements")

  @@unique([shelfId, code])
  @@map("bins")
}
