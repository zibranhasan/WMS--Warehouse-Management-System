model Warehouse {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  address     String?
  city        String?
  country     String?
  status      WarehouseStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("warehouses")
}
