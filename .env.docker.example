# ==============================================================================
# WMS Docker Environment Variables Example
# Copy this file to .env at root before starting Docker Compose:
# cp .env.docker.example .env
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=wms_secure_password
POSTGRES_DB=wms_db

# --- Backend Application ---
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# Better Auth & JWT
BETTER_AUTH_SECRET=your_better_auth_secret_key_min_32_chars
BETTER_AUTH_URL=http://localhost:5000
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Initial Super Admin Account
SUPER_ADMIN_EMAIL=admin@wms.local
SUPER_ADMIN_PASSWORD=SuperAdminPassword123!

# SMTP Email Configuration
EMAIL_SENDER_SMTP_USER=smtp_username@example.com
EMAIL_SENDER_SMTP_PASS=smtp_password_example
EMAIL_SENDER_SMTP_HOST=smtp.example.com
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_SMTP_FROM="WMS Alerts <noreply@wms.local>"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payments (Optional / Placeholder)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# --- Frontend Application ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
